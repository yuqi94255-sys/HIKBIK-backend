# 複製為 .env 後填入實際值（勿將 .env 提交至 Git）
# 本地測試請設為 development，可關閉 auth/integration 限流（避免 send-otp、PATCH /me 出現 429）
NODE_ENV=development
# 啟動時會自動偵測區網 IP（os.networkInterfaces），無需手寫熱點 IP
PORT=
# 生產環境必設且保持不變（Render Dashboard → Environment）；否則 Token 會 invalid signature
JWT_SECRET=
# 設為 1 時登入流程會打 [login-compare] 日誌（僅長度與 hash 前綴，不記錄明文密碼）
DEBUG_AUTH_LOGIN=
MONGODB_URI=
# 設為 true 時掛載 POST /api/test/seed-dummies、DELETE /api/test/purge-dummies（測試用；正式環境勿開，用完請刪 server.js 內掛載）
ENABLE_TEST_PURGE=

# 可選：設定後 OTP 會同步寫入 Redis（與 MongoDB 雙寫）；未設定則僅 MongoDB
REDIS_URL=
RESEND_API_KEY=

# Auth - Google
GOOGLE_CLIENT_ID=

# Auth - Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_KEY=

# 物流
EASYPOST_API_KEY=
SHIPPING_API_URL=

# Cloudinary
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenWeather
OPENWEATHER_BASE_URL=
OPENWEATHER_API_KEY=
OPENWEATHER_APPID=

# National Park Service（GET /api/parks 代理）
NPS_API_KEY=

# RIDB
RIDB_BASE_URL=
RIDB_API_KEY=

# RapidAPI（民宿 / 機票等）
RAPIDAPI_KEY=
RAPIDAPI_HOST_AIRBNB=
RAPIDAPI_HOST_FLIGHTS=
